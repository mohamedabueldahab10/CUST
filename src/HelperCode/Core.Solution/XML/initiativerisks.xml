			Group="SPM Fields" 
			Required="FALSE" 
			Type="Note" 
			DisplayName="Description"
			StaticName="Description" 
			Name="Description"/>	
	<Field 
				Required="TRUE"
				Type="Choice" 
				DisplayName="Impact" 
				StaticName="Impact" 
				Name="Impact">
				<CHOICES>
					<CHOICE>low</CHOICE>
					<CHOICE>medium</CHOICE>
					<CHOICE>hight</CHOICE>
				</CHOICES>
	</Field>
	<Field 
			Group="SPM Fields" 
			Required="FALSE" 
			Type="Note" 
			DisplayName="Impact Description"
			StaticName="ImpactDescription" 
			Name="ImpactDescription"/>	
	<Field 
			Group="SPM Fields" 
			Required="FALSE" 
			Type="Note" 
			DisplayName="Resolution Plan"
			StaticName="ResolutionPlan" 
			Name="ResolutionPlan"/>	

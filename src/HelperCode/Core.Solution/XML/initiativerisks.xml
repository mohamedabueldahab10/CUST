 <Fields>
	<Field 
				Required="FALSE" 
				MaxLength="255" 
				Type="Text" 
				DisplayName="Risk ID" 
				StaticName="Title" 
				Name="Title"/>
	<Field 
				Group="SPM Fields"
				Required="TRUE"
				MaxLength="255"
				Type="Text"
				DisplayName="Risk Name"
				StaticName="Name"
				Name="Name"/>		
	<Field 
				Required="FALSE"
				Type="Choice" 
				DisplayName="Risk Category" 
				StaticName="Category" 
				Name="Category">
				<CHOICES>
					<CHOICE>financial</CHOICE>
					<CHOICE>legal</CHOICE>
					<CHOICE>contractual</CHOICE>
					<CHOICE>others</CHOICE>
				</CHOICES>
	</Field>	
	<Field 
				Required="TRUE"
				Type="Choice" 
				DisplayName="Status" 
				StaticName="Status" 
				Name="Status">
				<CHOICES>
					<CHOICE>open</CHOICE>
					<CHOICE>closed</CHOICE>
				</CHOICES>
	</Field>	

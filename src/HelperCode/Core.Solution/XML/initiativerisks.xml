				Required="FALSE"
				Type="Choice" 
				DisplayName="Mitigation Status" 
				StaticName="MitigationStatus" 
				Name="MitigationStatus">
				<CHOICES>
					<CHOICE>notstarted</CHOICE>
					<CHOICE>inprogress</CHOICE>
					<CHOICE>done</CHOICE>
				</CHOICES>
	</Field>		
	<Field
				Group="SPM Fields"
				Required="TRUE"
				Type="User"
				DisplayName="Mitigation Owner"
				StaticName="MitigationOwner"
				Name="MitigationOwner"/>																				
	<Field 
				Group="SPM Fields"
				Required="FALSE"
				Type="DateTime" 
				Format="DateOnly"
				DisplayName="Mitigation Target Date"
				StaticName="MitigationTargetDate"
				Name="MitigationTargetDate"/>																			
	<Field 
				Group="SPM Fields"
				Required="FALSE"
				Type="DateTime" 
				Format="DateOnly"
				DisplayName="Mitigation Actual Completion Date"
				StaticName="MitigationActualCompletionDate"
				Name="MitigationActualCompletionDate"/>	
	<Field 
			Group="SPM Fields" 
			Required="FALSE" 
			Type="Note" 
			DisplayName="Mitigation Plan"
			StaticName="MitigationPlan" 
			Name="MitigationPlan"/>
	<Field 
				Required="FALSE"
				Type="Choice" 
				DisplayName="Agreed Action" 
				StaticName="AgreedAction" 
				Name="AgreedAction">
				<CHOICES>
					<CHOICE>mitigate</CHOICE>
					<CHOICE>monitor</CHOICE>
					<CHOICE>leave</CHOICE>
					<CHOICE>move</CHOICE>
					<CHOICE>avoid</CHOICE>
					<CHOICE>assumption</CHOICE>
				</CHOICES>
	</Field>	
	<Field 
			Name="MoveItToIssueList"
			StaticName="MoveItToIssueList"
			DisplayName="Move It To Issue List"
			Type="Choice"
			Required="FALSE"
			Group="SPM Fields"
			Format="RadioButtons">
			<CHOICES>
				<CHOICE>yes</CHOICE>
				<CHOICE>no</CHOICE>
			</CHOICES>
	</Field>	
	<Field 
			Name="InitiativeEscalation"
			StaticName="InitiativeEscalation"
			DisplayName="Escalate As Initiative Risk"
			Type="Choice"
			Required="FALSE"
			Group="SPM Fields"
			Format="RadioButtons">
		<CHOICES>
			<CHOICE>yes</CHOICE>
			<CHOICE>no</CHOICE>
		</CHOICES>
	</Field>			

